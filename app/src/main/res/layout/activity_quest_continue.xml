<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/game_screen_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🌟"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/questContinueTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.QuantumRealm.Hero"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/questContinueMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/questContinuePrimary"
            style="@style/Widget.QuantumRealm.Button.Success"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minHeight="56dp"
            android:text="@string/quest_continue_to_quiz" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/questContinueModuleMap"
            style="@style/Widget.QuantumRealm.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/quest_return_module_map" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/questContinueSubject"
            style="@style/Widget.QuantumRealm.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/quest_return_subject" />
    </LinearLayout>
</ScrollView>
