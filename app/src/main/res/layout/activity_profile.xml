<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/app_drawer_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_game_screen"
        android:orientation="vertical">

    <ScrollView
        android:id="@+id/profileMainScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="@dimen/game_screen_padding">

        <LinearLayout
            android:id="@+id/profileMainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/profileLoading"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_title"
                android:textAppearance="@style/TextAppearance.QuantumRealm.Hero" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.QuantumRealm.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/profileNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.QuantumRealm.Title"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/profileEmailText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/profileDashboardCard"
                style="@style/Widget.QuantumRealm.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_progression_title"
                        android:textAppearance="@style/TextAppearance.QuantumRealm.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/profile_progression_subtitle"
                        android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle" />

                    <TextView
                        android:id="@+id/profileRankText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="@style/TextAppearance.QuantumRealm.Title"
                        android:textSize="16sp" />

                    <ProgressBar
                        android:id="@+id/profileRankProgressBar"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/profileRankProgressText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle" />

                    <TextView
                        android:id="@+id/profileXpText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/profileNextLevelCard"
                        style="@style/Widget.QuantumRealm.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/profileNextLevelText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle"
                            android:textColor="@color/game_accent" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/profile_xp_rewards_heading"
                        android:textAppearance="@style/TextAppearance.QuantumRealm.Title"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:id="@+id/profileXpRewardsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/profileTitleTiersEntry"
                        style="@style/Widget.QuantumRealm.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/profile_title_tiers_heading"
                                android:textAppearance="@style/TextAppearance.QuantumRealm.Title"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_title_tiers_open"
                                android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle"
                                android:textColor="@color/game_accent" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/profileAchievementsEntry"
                        style="@style/Widget.QuantumRealm.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/profile_achievements_heading"
                                android:textAppearance="@style/TextAppearance.QuantumRealm.Title"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/profileAchievementsSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_achievements_open"
                                android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle"
                                android:textColor="@color/game_accent" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/profileStreakText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle" />

                    <TextView
                        android:id="@+id/profileDailyGoalText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/profileContinueQuestButton"
                        style="@style/Widget.QuantumRealm.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/profile_continue_quest"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/profile_quiz_scores_heading"
                android:textAppearance="@style/TextAppearance.QuantumRealm.Title" />

            <LinearLayout
                android:id="@+id/profileScoresContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/profileCertificateButton"
        style="@style/Widget.QuantumRealm.Button.Success"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/game_screen_padding"
        android:layout_marginEnd="@dimen/game_screen_padding"
        android:layout_marginBottom="8dp"
        android:text="@string/profile_view_certificate"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/profileLogoutButton"
        style="@style/Widget.QuantumRealm.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/game_screen_padding"
        android:layout_marginEnd="@dimen/game_screen_padding"
        android:layout_marginBottom="@dimen/game_screen_padding"
        android:minHeight="48dp"
        android:text="@string/profile_logout_button" />
    </LinearLayout>

    <include layout="@layout/include_app_nav_view" />
</androidx.drawerlayout.widget.DrawerLayout>
