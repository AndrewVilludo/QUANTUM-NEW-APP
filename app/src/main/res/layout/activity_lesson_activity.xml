<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/game_screen_padding">

        <TextView
            android:id="@+id/activityLessonTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.QuantumRealm.Hero"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/activityLessonSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.QuantumRealm.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/activityChallengeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.QuantumRealm.Title"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/activityDifficultyBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/challenge_difficulty_badge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle"
                    android:textColor="@color/game_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/lesson_question_label"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle"
                    android:textColor="@color/game_text_muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/activityQuestionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:textAppearance="@style/TextAppearance.QuantumRealm.Title"
                    android:textSize="17sp" />

                <EditText
                    android:id="@+id/activityAnswerInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/input_field_game"
                    android:gravity="top|start"
                    android:hint="@string/lesson_answer_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="2"
                    android:padding="16dp"
                    android:textColor="@color/game_text_primary"
                    android:textColorHint="@color/game_text_muted"
                    android:textSize="16sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/activitySubmitButton"
            style="@style/Widget.QuantumRealm.Button.ChallengeSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:text="@string/lesson_submit_answer_cta"
            app:icon="@drawable/ic_check_answer"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/white" />

        <ProgressBar
            android:id="@+id/activitySubmitProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:indeterminateTint="@color/game_success"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
