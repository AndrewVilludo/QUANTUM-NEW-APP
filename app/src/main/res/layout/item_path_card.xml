<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pathCardRoot"
    style="@style/Widget.QuantumRealm.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/game_card_margin"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/game_accent_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <TextView
                android:id="@+id/pathEmoji"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="📘"
                android:textSize="22sp" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/pathCurrentLottie"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/blue_circle" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pathTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.QuantumRealm.Title"
                    android:textSize="18sp"
                    tools:text="Introduction to Computing" />

                <TextView
                    android:id="@+id/pathCurrentBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/module_completed_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="@string/lesson_status_current"
                    android:textAllCaps="true"
                    android:textColor="@color/game_accent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/pathCompletedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/module_completed_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="@string/module_completed_badge"
                    android:textAllCaps="true"
                    android:textColor="@color/game_success"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/pathSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tap to continue your quest"
                android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle" />
        </LinearLayout>

        <ImageView
            android:id="@+id/pathCompleteIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/module_completed"
            android:src="@drawable/ic_module_complete"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/pathLockIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/locked_level"
            android:src="@drawable/block"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
