<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/game_screen_padding">

        <TextView
            android:id="@+id/moduleTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.QuantumRealm.Hero"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/modulePathSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:text="@string/module_path_subtitle"
            android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/moduleContinueButton"
            style="@style/Widget.QuantumRealm.Button.Success"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/module_continue_quest"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/moduleContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
