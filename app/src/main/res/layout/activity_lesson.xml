<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_screen"
    android:orientation="vertical"
    android:padding="@dimen/game_screen_padding">

    <TextView
        android:id="@+id/lessonModuleHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle"
        android:textColor="@color/game_accent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lessonTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.QuantumRealm.Hero"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/lessonSwipeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/lesson_swipe_hint"
        android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/lessonSlideProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/lesson_progress_bar" />

    <TextView
        android:id="@+id/lessonSlideProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/lessonSlidePager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/lessonDotIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lessonMicroCheckCard"
        style="@style/Widget.QuantumRealm.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lesson_micro_check_title"
                android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle"
                android:textColor="@color/game_accent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lessonMicroCheckQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.QuantumRealm.Title"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/lessonMicroCheckOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lessonMicroCheckButton"
                style="@style/Widget.QuantumRealm.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/lesson_micro_check_confirm" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lessonPrevButton"
            style="@style/Widget.QuantumRealm.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/lesson_prev" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lessonNextButton"
            style="@style/Widget.QuantumRealm.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/lesson_next" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/lessonContinueActivityButton"
        style="@style/Widget.QuantumRealm.Button.Success"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/lesson_start_activity"
        android:visibility="gone" />

</LinearLayout>
