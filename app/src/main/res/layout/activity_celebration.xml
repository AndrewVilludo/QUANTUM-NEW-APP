<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_screen">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/game_screen_padding">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/celebrationLottie"
                android:layout_width="200dp"
                android:layout_height="200dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/green_circle" />

            <TextView
                android:id="@+id/celebrationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.QuantumRealm.Hero"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/celebrationRankChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/quiz_option_background"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle"
                android:textColor="@color/game_accent"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/celebrationRankProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progressDrawable="@drawable/progress_quiz"
                android:visibility="gone" />

            <TextView
                android:id="@+id/celebrationXpLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/game_xp_gold"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/celebrationBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/celebrationPrimaryButton"
                style="@style/Widget.QuantumRealm.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/celebration_continue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/celebrationSecondaryButton"
                style="@style/Widget.QuantumRealm.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/celebration_review_answers"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/celebrationCertificateButton"
                style="@style/Widget.QuantumRealm.Button.Success"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/profile_view_certificate"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
