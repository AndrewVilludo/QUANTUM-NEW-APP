<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_screen"
    android:orientation="vertical">

    <TextView
        android:id="@+id/graduationTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/game_screen_padding"
        android:text="@string/graduation_title"
        android:textAppearance="@style/TextAppearance.QuantumRealm.Hero" />

    <TextView
        android:id="@+id/graduationSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/game_screen_padding"
        android:paddingBottom="8dp"
        android:text="@string/graduation_subtitle"
        android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle" />

    <WebView
        android:id="@+id/graduationWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/game_screen_padding"
        android:layout_weight="1"
        android:background="@android:color/transparent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/game_screen_padding">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/graduationPrintButton"
            style="@style/Widget.QuantumRealm.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/graduation_print" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/graduationDoneButton"
            style="@style/Widget.QuantumRealm.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/graduation_done" />
    </LinearLayout>
</LinearLayout>
