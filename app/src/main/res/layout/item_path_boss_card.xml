<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pathBossCardRoot"
    style="@style/Widget.QuantumRealm.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/game_card_margin"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/game_surface_elevated"
    app:rippleColor="@color/game_accent_soft"
    app:strokeColor="@color/game_xp_gold"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/pathBossEmoji"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⚔️"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pathBossTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.QuantumRealm.Title"
                android:textColor="@color/game_xp_gold"
                android:textSize="18sp"
                tools:text="Module quiz" />

            <TextView
                android:id="@+id/pathBossSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/module_quiz_boss_subtitle"
                android:textAppearance="@style/TextAppearance.QuantumRealm.Subtitle"
                android:textColor="@color/game_text_secondary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
