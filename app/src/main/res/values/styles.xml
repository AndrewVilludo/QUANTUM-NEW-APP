<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.QuantumRealm.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/game_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.QuantumRealm.Subtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/game_text_secondary</item>
    </style>

    <style name="TextAppearance.QuantumRealm.Hero" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/game_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.QuantumRealm.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/game_button_radius</item>
        <item name="backgroundTint">@color/game_primary</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.QuantumRealm.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/game_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/game_button_radius</item>
        <item name="strokeColor">@color/game_accent</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.QuantumRealm.Button.Success" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/game_button_radius</item>
        <item name="backgroundTint">@color/game_success</item>
    </style>

    <style name="Widget.QuantumRealm.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/game_surface</item>
        <item name="cardCornerRadius">@dimen/game_card_radius</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeColor">@color/game_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.QuantumRealm.RadioOption" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:textColor">@color/game_text_primary</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/quiz_option_background</item>
        <item name="android:buttonTint">@color/game_accent</item>
    </style>

</resources>
