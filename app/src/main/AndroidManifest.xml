<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <application
        android:name=".Music"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuantumRealm"
        tools:targetApi="31">

        <activity android:name=".YearActivity"/>
        <activity android:name=".ModuleActivity"/>
        <activity
            android:name=".LessonActivity"
            android:launchMode="singleTop"/>
        <activity android:name=".LessonActivityActivity"/>
        <activity android:name=".SubjectFinalQuizActivity"/>
        <activity android:name=".ModuleQuizActivity"/>
        <activity android:name=".QuestContinueActivity"/>
        <activity android:name=".ProfileActivity"/>
        <activity android:name=".TitleTiersActivity"/>
        <activity android:name=".AchievementsActivity"/>
        <activity android:name=".CourseActivity"/>
        <activity
            android:name=".ForgotPasswordActivity"
            android:theme="@style/Theme.QuantumRealm.Auth" />
        <activity
            android:name=".Register"
            android:theme="@style/Theme.QuantumRealm.Auth" />
        <activity android:name=".StudyJourney"/>
        <activity android:name=".SplashActivity"/>
        <activity android:name=".QuizActivity"/>
        <activity android:name=".Journey"/>
        <activity android:name=".GraduationActivity"/>
        <activity
            android:name=".CelebrationActivity"
            android:theme="@style/Theme.QuantumRealm" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.QuantumRealm.Auth">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>